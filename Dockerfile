# Generated by Autore CLI — Multi-stage Go Dockerfile (Auto-detect module / cmd)
# Toolchain 1.27 (bukan 1.22): stdlib Go 1.22 terukur punya 26 CVE HIGH/CRITICAL
# (CVE-2025-68121 CRITICAL crypto/tls; perbaikannya baru ada di 1.27.x). Tag minor
# sengaja tidak di-pin ke patch supaya perbaikan CVE berikutnya ikut terbawa.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY . .
RUN if [ -f go.mod ]; then \
        go test ./... && \
        if [ -d ./cmd/server ]; then CGO_ENABLED=0 go build -o /out/app ./cmd/server; \
        elif [ -d ./cmd/api ]; then CGO_ENABLED=0 go build -o /out/app ./cmd/api; \
        else CGO_ENABLED=0 go build -o /out/app .; fi; \
    else \
        CGO_ENABLED=0 go build -o /out/app *.go; \
    fi

# alpine 3.21, bukan 3.20: 3.20 sudah EOL sehingga Trivy menandai image tanpa
# perbaikan keamanan. 3.21 terukur bersih untuk paket OS-nya.
FROM alpine:3.21
WORKDIR /app
COPY --from=build /out/app /app/app
RUN adduser -D -H appuser
USER appuser
EXPOSE 8080
ENTRYPOINT ["/app/app"]
